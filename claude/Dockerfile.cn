# Stage 1: Download cc-proxy
FROM alpine:3.20 AS cc-proxy-downloader

ARG CC_PROXY_VERSION="0.1.0"
ARG TARGETARCH

RUN apk add --no-cache curl \
    && curl -L -o /out/cc-proxy "https://github.com/courage-zen/cc-proxy/releases/download/v${CC_PROXY_VERSION}/cc-proxy-${TARGETARCH}" \
    && chmod +x /out/cc-proxy

# Stage 2: Download multica
FROM alpine:3.20 AS multica-downloader

ARG MULTICA_VERSION="0.3.2"
ARG TARGETARCH

RUN apk add --no-cache curl tar

RUN case "${TARGETARCH}" in \
         amd64) ARCH="amd64" ;; \
         arm64) ARCH="arm64" ;; \
         *)     ARCH="amd64" ;; \
    esac \
    && curl -L -o /tmp/multica.tar.gz "https://github.com/multica-ai/multica/releases/download/v${MULTICA_VERSION}/multica-cli-${MULTICA_VERSION}-linux-${ARCH}.tar.gz" \
    && tar -xzf /tmp/multica.tar.gz -C /out \
    && chmod +x /out/multica \
    && rm -f /tmp/multica.tar.gz

# Stage 3: Final image (Chinese mirror)
FROM ghcr.nju.edu.cn/library/node:20-bookworm-slim

RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-yaml git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG CLAUDE_CODE_VERSION="2.1.100"

RUN npm config set registry https://registry.npmmirror.com \
    && npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION:-2.1.100}

COPY --from=cc-proxy-downloader /out/cc-proxy /usr/local/bin/cc-proxy
COPY --from=multica-downloader   /out/multica  /usr/local/bin/multica

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV CC_SWITCH_CONFIG_DIR=/etc/cc-proxy

ENTRYPOINT ["/entrypoint.sh"]
